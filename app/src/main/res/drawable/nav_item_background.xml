<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle"><solid android:color="@color/focus_accent" /><corners android:radius="14dp" /></shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle"><solid android:color="@color/screen_white" /><corners android:radius="14dp" /></shape>
    </item>
    <item><shape android:shape="rectangle"><solid android:color="@android:color/transparent" /><corners android:radius="14dp" /></shape></item>
</selector>
