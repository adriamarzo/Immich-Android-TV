<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_black">

    <ImageView
        android:id="@+id/home_hero_image"
        android:layout_width="match_parent"
        android:layout_height="@dimen/home_hero_height"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/home_hero_height"
        android:background="@drawable/hero_scrim_start" />

    <View
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:layout_marginTop="190dp"
        android:background="@drawable/hero_scrim_bottom" />

    <TextView
        android:id="@+id/home_hero_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="172dp"
        android:fontFamily="@font/figtree_semibold"
        android:shadowColor="#CC000000"
        android:shadowRadius="6"
        android:textColor="@color/screen_white"
        android:textSize="14sp" />
</FrameLayout>
